            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(DataFolder & \"\\dim_date.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers,{{\"Date\", type date}, {\"Year\", Int64.Type}, {\"Month\", type text}, {\"MonthSort\", Int64.Type}},\"en-US\")\nin\n Typed"
            }
          }
        ]
      }
    ],
    "relationships": [
