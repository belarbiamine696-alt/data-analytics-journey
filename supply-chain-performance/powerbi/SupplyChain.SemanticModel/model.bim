              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(DataFolder & \"\\dim_markets.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers,{{\"Market\", type text}},\"en-US\")\nin\n Typed"
            }
          }
        ]
      },
      {
        "name": "DimDate",
