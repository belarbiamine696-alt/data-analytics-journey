            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "ShippingDate",
            "dataType": "dateTime",
            "sourceColumn": "ShippingDate",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "ShippingMode",
            "dataType": "string",
            "sourceColumn": "ShippingMode",
            "summarizeBy": "none"
          },
          {
            "name": "Market",
            "dataType": "string",
            "sourceColumn": "Market",
            "summarizeBy": "none"
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product",
            "summarizeBy": "none"
          },
          {
            "name": "OrderStatus",
            "dataType": "string",
            "sourceColumn": "OrderStatus",
            "summarizeBy": "none"
          },
          {
            "name": "DeliveryStatus",
            "dataType": "string",
            "sourceColumn": "DeliveryStatus",
            "summarizeBy": "none"
          },
          {
            "name": "ActualDays",
            "dataType": "int64",
            "sourceColumn": "ActualDays",
            "summarizeBy": "none"
          },
          {
            "name": "ScheduledDays",
            "dataType": "int64",
            "sourceColumn": "ScheduledDays",
            "summarizeBy": "none"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "none"
          },
          {
            "name": "NetSales",
            "dataType": "double",
            "sourceColumn": "NetSales",
            "summarizeBy": "sum"
          },
          {
            "name": "ReportedBenefit",
            "dataType": "double",
            "sourceColumn": "ReportedBenefit",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "FactLines",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n Source = Csv.Document(File.Contents(DataFolder & \"\\order_lines.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),\n Typed = Table.TransformColumnTypes(Headers,{{\"OrderId\", Int64.Type}, {\"OrderItemId\", Int64.Type}, {\"OrderDate\", type date}, {\"ShippingDate\", type date}, {\"ShippingMode\", type text}, {\"Market\", type text}, {\"Region\", type text}, {\"Category\", type text}, {\"Product\", type text}, {\"OrderStatus\", type text}, {\"DeliveryStatus\", type text}, {\"ActualDays\", Int64.Type}, {\"ScheduledDays\", Int64.Type}, {\"Quantity\", Int64.Type}, {\"NetSales\", type number}, {\"ReportedBenefit\", type number}},\"en-US\")\nin\n Typed"
            }
          }
        ]
      },
